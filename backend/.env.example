# Copy this file to .env and fill in your AWS credentials.
#
# AWS Academy / student accounts issue TEMPORARY credentials that expire
# every few hours and include a session token - all three values below are
# required (a permanent IAM user key pair would only need the first two).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=JournalEntries

# Filled in automatically by python3 setup_realtime.py.
WEBSOCKET_URL=
USER_PROFILES_TABLE_NAME=LifesafeUserProfiles
USER_SEARCH_TABLE_NAME=LifesafeUserSearch
FRIENDSHIPS_TABLE_NAME=LifesafeFriendships
MESSAGES_TABLE_NAME=LifesafeMessages
CONNECTIONS_TABLE_NAME=LifesafeWebSocketConnections
