{
  // OTP auth microservice. Replace the KV id and vars below with your own,
  // then set the JWT secret with: wrangler secret put JWT_SECRET
  "name": "otp-auth",
  "main": "src/index.js",
  "compatibility_date": "2025-06-01",

  // Cloudflare Email Service binding -> env.EMAIL
  "send_email": [{ "name": "EMAIL" }],

  // KV used to hold pending OTP codes (auto-expire after 10 min).
  // Create one with: wrangler kv namespace create OTP_KV
  // then paste its id here.
  "kv_namespaces": [
    { "binding": "OTP_KV", "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID" }
  ],

  "vars": {
    // Must be a verified sender in your Cloudflare Email Service account.
    "SENDER_EMAIL": "no-reply@yourdomain.com",
    // The frontend origin allowed to call this API (CORS).
    "ALLOWED_ORIGIN": "http://localhost:5173",
    // "production" sends real email; "dev" logs the code to the console instead.
    "ENVIRONMENT": "production"
  }
}
